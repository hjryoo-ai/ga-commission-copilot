            "RATE_LIMITED",
            "ENGINE_CONTRACT",
            "ENGINE_UNAVAILABLE",
            "TURNSTILE_REQUIRED",
            "PROVIDER_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "$ref": "#/components/schemas/AskBudget"
        },
        "answerId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
