{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ga.example/copilot/contracts/rulebook/v1/chunk.schema.json",
  "title": "사규집 청크 v1(설계서 §4.1(c)·§5.1 rulebook_chunk·§5.2)",
  "description": "data/rulebook/<hash>/chunks.jsonl 한 줄 = D1 rulebook_chunk 한 행 = Vectorize 벡터 하나(id = chunkId, 메타 article·visibility·version·chunk_id).",
  "type": "object",
  "additionalProperties": false,
  "required": ["chunkId", "article", "title", "body", "visibility", "version", "tokenCount"],
  "properties": {
    "chunkId": { "type": "string", "pattern": "^rb-[0-9a-f]{12}-a[0-9]{2}-[0-9]+$" },
    "article": { "type": "string", "pattern": "^제[1-9][0-9]*조$" },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "visibility": { "enum": ["agent", "internal"] },
    "version": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "tokenCount": { "type": "integer", "minimum": 1, "maximum": 600 }
  }
}
