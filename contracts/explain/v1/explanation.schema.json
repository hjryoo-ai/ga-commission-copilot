{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ga.example/copilot/contracts/explain/v1/explanation.schema.json",
  "title": "사전 생성 설명 레코드 v1(data/explain/<streamHash>/<kind>.jsonl 한 줄 — D1 explanation 행의 원본)",
  "description": "설계서 v0.1.14 §4.1(b)·§5.1. 캐시 키 = streamHash + promptVersion + kind + subjectId. FAIL 행도 남긴다(화면에는 '설명 없음').",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "agentId", "kind", "subjectId", "streamHash", "promptVersion", "provider", "model", "text", "citedFields", "numbersUsed", "groundingStatus", "attempts", "createdAt"],
  "properties": {
    "tenantId": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "pattern": "^A-[0-9]{4}$" },
    "kind": { "enum": ["LINE", "LIMIT", "MONTH_DIFF"] },
    "subjectId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "streamHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "promptVersion": { "type": "string", "pattern": "^explain_(line|limit|month)/v[1-9][0-9]*$" },
    "provider": { "enum": ["groq", "workers-ai", "vcr"] },
    "model": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "maxLength": 1200 },
    "citedFields": { "type": "array", "items": { "type": "string" } },
    "numbersUsed": { "type": "array", "items": { "type": "string" } },
    "groundingStatus": { "enum": ["PASS", "FAIL"] },
    "attempts": { "type": "integer", "minimum": 1, "maximum": 2 },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["g4", "g5", "g6"],
      "properties": {
        "g4": { "type": "array", "items": { "type": "string" } },
        "g5": { "type": "array", "items": { "type": "string" } },
        "g6": { "type": "array", "items": { "type": "string" } }
      }
    },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" }
  }
}
