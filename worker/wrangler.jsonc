{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ga-commission-copilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],

  // 설계서 §6.3: prompts/<name>/v<N>.md는 텍스트 모듈로 묶는다(llm/promptRegistry.ts). 시험은 vitest.config.ts의 같은 변환.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // 설계서 §11: 정적 자산은 Assets 바인딩. /api/* 만 Worker가 먼저 받는다(정적 요청은 Worker 호출로 집계되지 않게).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // 설계서 §5.1·D-6: 읽기 모델·LLM 테이블·예산 카운터는 전부 D1
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "copilot",
      "database_id": "f97c77d4-3afc-4ec3-ae17-d91bee6015dc",
      "migrations_dir": "migrations"
    }
  ],

  // 설계서 §5.2: rulebook-v1, 1024차원(bge-m3), cosine — `wrangler vectorize create rulebook-v1 --dimensions=1024 --metric=cosine`
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "rulebook-v1" }
  ],

  // 설계서 D-7: 임베딩 @cf/baai/bge-m3, 폴백 @cf/openai/gpt-oss-120b
  "ai": { "binding": "AI" },

  // 설계서 §6.3: 활성 프롬프트 버전. 설명(v0.1.14)은 explanation.prompt_version이 이 값인 행만 내보낸다.
  "vars": {
    "PROMPT_VERSIONS": "explain_line=v6,explain_limit=v6,explain_month=v6,answer=v3"
  },

  "observability": { "enabled": true },

  // 답변 녹화 전용 환경(운영자 2026-11-02 — 부록 A 12건 VCR): `pnpm exec wrangler dev --env record`(--local을 붙이면 원격 바인딩이 모두 꺼진다 — wrangler 4.153 확인).
  // 평소 dev·시험·배포는 이 env를 쓰지 않는다. 다른 점은 Vectorize만 원격 바인딩(Miniflare에 로컬 Vectorize가 없다) — D1은 로컬 그대로, AI는 원래 늘 원격(질문 임베딩 bge-m3)이라 remote를 적어 둘 뿐이다.
  // 나머지는 위와 같게(env는 바인딩·vars를 물려받지 않는다).
  // LLM_TRACE=1·GROQ_API_KEY는 여기 두지 않고 worker/.dev.vars.record(커밋 안 함 — 이 env에서만 읽힌다)에 둔다. 위와 같은지는 test/arch.test.ts가 본다.
  "env": {
    "record": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "copilot",
          "database_id": "f97c77d4-3afc-4ec3-ae17-d91bee6015dc",
          "migrations_dir": "migrations"
        }
      ],
      "vectorize": [
        { "binding": "VECTORIZE", "index_name": "rulebook-v1", "remote": true }
      ],
      "ai": { "binding": "AI", "remote": true },
      "vars": {
        "PROMPT_VERSIONS": "explain_line=v6,explain_limit=v6,explain_month=v6,answer=v3"
      }
    }
  }
}
