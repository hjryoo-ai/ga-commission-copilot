# pr:10 재채점 — 설계서 v0.1.49 정의(json_validate_failed = 케이스 실패, R3은 인프라 오류만), 2026-11-19, LLM 0
# 입력: CI 산출물 eval-out(run 44301147286)의 runs.jsonl·ref.json(CI가 쓴 기준 그대로). pr:10은 4xx 코드를 기록하기 전이라 'groq 400'만 남아 있다 — 로컬 재현에서 A-04·A-08·G-15는 json_validate_failed, G-31은 재현 안 됨(두 패스 모두 1단계 성공).
# 네 건 모두 usage가 비어 있다 = 첫 호출(1단계)에서 실패 → 툴 축은 부른 툴 없음.

## 스크립트
```ts
// pr:10을 설계서 v0.1.49 정의로 다시 매긴다(LLM 0) — groq 400 오류 행을 json_validate_failed 케이스 실패로.
import { copyFileSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { type CaseRun, type EvalCase, schemaFailureRun, scoreCase } from "/Users/hjr/Documents/workspace/ai/ga-commision-copilot/evals/src/score.ts";
const [src, out, onlyArg] = process.argv.slice(2) as [string, string, string | undefined];
const only = onlyArg ? new Set(onlyArg.split(",")) : null;
const cases = new Map(readFileSync("/Users/hjr/Documents/workspace/ai/ga-commision-copilot/evals/cases.jsonl", "utf8").split("\n").filter(Boolean).map((l) => { const c = JSON.parse(l) as EvalCase; return [c.id, c]; }));
mkdirSync(out, { recursive: true });
const lines: string[] = [];
for (const l of readFileSync(join(src, "runs.jsonl"), "utf8").split("\n").filter(Boolean)) {
  const { score: _old, ...r } = JSON.parse(l) as CaseRun & { score: unknown };
  let run: CaseRun = r;
  if (r.error?.startsWith("Error: groq 400") && (!only || only.has(r.caseId))) {
    const { error: _e, ...rest } = r;
    run = schemaFailureRun(rest, { provider: "groq", code: "json_validate_failed", detail: null, toolCalls: [] });
  }
  lines.push(JSON.stringify({ ...run, score: scoreCase(cases.get(r.caseId)!, run) }));
}
writeFileSync(join(out, "runs.jsonl"), lines.join("\n") + "\n");
copyFileSync(join(src, "summary.json"), join(out, "summary.json"));
```

